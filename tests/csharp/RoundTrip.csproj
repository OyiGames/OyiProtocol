<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-language round trip, C# side. GeneratedDir (command line) is the C# output of flatc for
    schema/oyi_protocol.fbs; the FlatBuffers runtime comes from third_party/flatbuffers-net, the same
    way OyiEditor consumes it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>roundtrip</AssemblyName>
    <RootNamespace>Oyi.Protocol.RoundTrip</RootNamespace>
  </PropertyGroup>

  <Import Project="../../third_party/flatbuffers-net/OyiProtocol.FlatBuffers.props" />

  <ItemGroup>
    <Compile Include="$(GeneratedDir)/**/*.cs" />
  </ItemGroup>

  <Target Name="CheckInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(GeneratedDir)' == '' Or !Exists('$(GeneratedDir)')" Text="Pass -p:GeneratedDir=&lt;flatc C# output dir&gt;" />
  </Target>

</Project>
